{
  "compilerOptions": {
    "outDir": "lib",
    "module": "commonjs",
    "lib": ["es6"],
    "target": "es2016",
    "esModuleInterop": true,
    "strict": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"]
}
